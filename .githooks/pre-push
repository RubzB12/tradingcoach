#!/bin/sh
# SignalDeck local quality gate. There is no GitHub CI (no Actions minutes), so this hook
# is what stops a push that breaks the invariants or the tests. See docs/decisions/0002-*.md.
#
# Activate once per clone:  git config core.hooksPath .githooks   (or: just hooks)
# Never bypass with `git push --no-verify` (CLAUDE.md).

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-push: running the local quality gate..."

if [ -f justfile ] && command -v just >/dev/null 2>&1; then
    # Full gate: lint + structural + unit + contract drift (defined in X2-WP03).
    if ! just check; then
        echo "pre-push: 'just check' failed - push blocked." >&2
        exit 1
    fi
else
    # Before the justfile exists (Phase 0): run the structural invariant tests only.
    # Pick the first interpreter that actually runs. On Windows `python3` can be a Microsoft Store
    # stub that is on PATH but fails, so `command -v` alone is not enough.
    PY=""
    for candidate in python python3 py; do
        if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys" >/dev/null 2>&1; then
            PY="$candidate"; break
        fi
    done
    if [ -z "$PY" ]; then
        echo "pre-push: no python found - cannot run the structural tests; push blocked." >&2
        exit 1
    fi
    if ! "$PY" -m unittest discover -s tests/structural; then
        echo "pre-push: structural tests failed - push blocked." >&2
        exit 1
    fi
fi

echo "pre-push: gate passed."
exit 0
