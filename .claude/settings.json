{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(just)",
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "Bash(uv venv *)",
      "Bash(uv pip list *)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm --filter *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(git checkout -b wp/*)",
      "Bash(git checkout -b chore/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --ff-only *)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python -m unittest *)",
      "Bash(python .claude/hooks/*)",
      "Bash(ruff *)",
      "Bash(pyright)",
      "Bash(pyright *)",
      "Bash(lint-imports)",
      "Bash(lint-imports *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git tag *)",
      "Bash(docker compose down)",
      "Bash(docker compose down *)",
      "Bash(uv remove *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Write(./.env.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down -v)",
      "Bash(docker volume prune *)",
      "Edit(./apps/web/lib/contracts/**)",
      "Write(./apps/web/lib/contracts/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_invariants.py\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_invariants.py\" --command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_changed.py\""
          }
        ]
      }
    ]
  }
}
